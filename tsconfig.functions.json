{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noImplicitReturns": true,

    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["netlify/functions"]
}
